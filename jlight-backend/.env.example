# JLIGHT v4 — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/jlight

# Supabase JWT verification for protected backend routes
# Required: project URL. The issuer defaults to {SUPABASE_URL}/auth/v1.
SUPABASE_URL=https://your-project.supabase.co
# Optional overrides for custom issuer/JWKS deployments:
# SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Only set this server-side when the project uses HS256 signing; never expose it in frontend code.
# SUPABASE_JWT_SECRET=replace-with-your-hs256-signing-secret

# Flask
FLASK_ENV=production
SECRET_KEY=your-secret-key-change-this-to-something-random-and-long

# Port
PORT=5000

# CORS - add your frontend domain
ALLOWED_ORIGINS=https://jlight-health.co.za,http://localhost:3000
