# JLIGHT v4 — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/jlight

# Supabase Auth: configure SUPABASE_URL for JWKS validation, or use the legacy HS256 pair below.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_JWT_SECRET=replace-only-if-using-legacy-HS256-tokens
# JLIGHT_JWT_ISSUER=https://your-auth-issuer.example/auth/v1

# Patient crosswalk: generate a random secret of at least 32 characters; never commit it.
# Keep the same secret across API instances so source identity hashes remain stable.
JLIGHT_LINKING_SECRET=replace-with-a-random-secret-at-least-32-characters

# Flask
FLASK_ENV=production
SECRET_KEY=your-secret-key-change-this-to-something-random-and-long

# Port
PORT=5000

# CORS - add your frontend domain
ALLOWED_ORIGINS=https://jlight-health.co.za,http://localhost:3000
